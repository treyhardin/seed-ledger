{
  "name": "seed-ledger",
  "version": "0.1.0",
  "description": "A self-hosted garden planner: log seed packets, track plantings, and see the growing year at a glance.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js --dev",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.7",
    "vite-plugin-solid": "^2.11.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
